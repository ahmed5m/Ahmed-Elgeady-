rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isAdmin() {
      return request.auth != null 
        && (request.auth.token.email == "ahmedeljeady@gmail.com" || request.auth.token.email == "ahmedjp070@gmail.com")
        && request.auth.token.email_verified == true;
    }

    function incoming() { 
      return request.resource.data; 
    }

    // Validation helpers
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'description', 'createdAt'])
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && data.createdAt == request.time
        && (data.keys().size() == 4 || (data.keys().size() == 5 && data.phone is string));
    }

    function isValidClient(data) {
      return data.keys().hasAll(['name', 'email', 'status', 'createdAt'])
        && data.status in ['lead', 'active', 'past']
        && data.createdAt == request.time
        && (data.keys().size() >= 4 && data.keys().size() <= 7);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['clientId', 'title', 'status', 'createdAt'])
        && data.status in ['planning', 'in-progress', 'completed', 'on-hold']
        && (data.keys().size() >= 4 && data.keys().size() <= 10);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['projectId', 'title', 'isCompleted'])
        && data.isCompleted is bool
        && (data.keys().size() >= 3 && data.keys().size() <= 8);
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'status', 'createdAt'])
        && data.status in ['available', 'busy', 'away']
        && data.createdAt == request.time
        && (data.keys().size() == 5 || (data.keys().size() == 6 && data.phone is string));
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read, write: if isAdmin();
      allow create: if isAdmin() && isValidClient(incoming());
    }

    match /projects/{projectId} {
      allow read, write: if isAdmin();
      allow create: if isAdmin() && isValidProject(incoming());
    }

    match /tasks/{taskId} {
      allow read, write: if isAdmin();
      allow create: if isAdmin() && isValidTask(incoming());
    }

    match /team/{memberId} {
      allow read, write: if isAdmin();
      allow create: if isAdmin() && isValidTeamMember(incoming());
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      allow update: if request.auth != null && (incoming().diff(existing()).affectedKeys().hasOnly(['read']));
    }
  }
}
